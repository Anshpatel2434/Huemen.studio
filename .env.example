# =============================================================================
# Huemen.studio — environment configuration
# Copy to `.env` for local dev. NEVER commit `.env`. Secrets live here only,
# never in source (brief §07). Rotate all secrets before handover.
# =============================================================================

# --- App ---------------------------------------------------------------------
APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database ----------------------------------------------------------------
# RUNTIME role — MUST be a non-owner, NOSUPERUSER, NOBYPASSRLS role so that
# Row-Level Security is actually enforced on every query (brief §07, INV-1).
DATABASE_URL=postgresql://huemen_app:CHANGE_ME_APP_PW@localhost:5544/huemen
# ADMIN/owner role — used ONLY by the migration runner (creates tables, roles,
# RLS policies). Never used to serve requests.
DATABASE_ADMIN_URL=postgresql://huemen:CHANGE_ME_OWNER_PW@localhost:5544/huemen
# Password the migrator assigns to the runtime role when bootstrapping it.
# Must match the password in DATABASE_URL above.
DATABASE_APP_PASSWORD=CHANGE_ME_APP_PW
# Connections per server instance. 10 for one long-running server. On Vercel
# each function instance has its own pool: use 1 to 3, and point DATABASE_URL
# at the transaction pooler (Supabase: port 6543, user huemen_app.<project-ref>).
# DATABASE_ADMIN_URL should use a direct or session connection (port 5432).
# Managed Postgres (Supabase, RDS) works: the migrator needs CREATEROLE, not
# superuser, and refuses to finish if huemen_app could bypass RLS.
DATABASE_POOL_MAX=10

# --- Auth ---------------------------------------------------------------------
# Passwordless, invite-only: people sign in with a one-time link sent to their
# email (15 minutes, works once); invites are emailed too (7 days).
#   dev   = one-click sign-in for seeded accounts, links shown on screen. Local only.
#   email = production. Needs MAIL_PROVIDER=resend below; the app will not start without it.
# Generate AUTH_SECRET once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=CHANGE_ME_32_BYTE_RANDOM_STRING
AUTH_DRIVER=dev

# --- Email (sign-in links, invites) -------------------------------------------
#   log    = written to the server log only (local work).
#   resend = sent through Resend (resend.com). Verify the sending domain there first
#            (its DNS records), then set the key and a sender on that domain.
MAIL_PROVIDER=log
# RESEND_API_KEY=
# MAIL_FROM=Huemen.studio <studio@yourdomain.com>

# --- Storage -----------------------------------------------------------------
# Object storage for uploads + generated images. Keys are tenant-prefixed and
# URLs are signed + short-lived (brief §07, INV-1). Dev uses the local driver.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
STORAGE_SIGNED_URL_TTL_SECONDS=300
# For the S3-compatible driver (production; hosted servers don't keep local files):
#   AWS S3:           leave STORAGE_S3_ENDPOINT empty.
#   Supabase Storage: STORAGE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
#                     (keys from Project Settings > Storage > S3 access keys).
#   Cloudflare R2:    STORAGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, region "auto".
# Keep the bucket PRIVATE: files are served through the app's own signed links.
# Uploads go from the browser straight to the bucket on a one-time signed PUT
# (no request-size limit). The bucket needs a CORS rule allowing PUT from
# APP_URL with the Content-Type header; without one, files up to 4 MB still
# arrive through the app, and larger ones are refused.
# STORAGE_DRIVER=s3
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_ENDPOINT=

# --- AI layer ----------------------------------------------------------------
# Provider-agnostic wrapper. Model + params are CONFIG, never hardcoded in
# feature code (brief §05). Dev uses a deterministic mock provider (no keys,
# no cost, formulaic copy that proves the brand context was injected).
#
# Built text providers: mock, anthropic. Choosing anything else (openai) is a
# loud error on the first draft, never a silent fallback to the mock.
#
# To write with Claude:
#   AI_TEXT_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=<your key>
#   AI_TEXT_MODEL_STRONG=claude-opus-5-5
#   AI_TEXT_MODEL_CHEAP=claude-opus-5-5
# Both models must be set once a real provider is chosen; the app will not
# guess one. The cheap route (hook sets) may point at a cheaper model; that is
# a cost decision for whoever runs this, not a default.
AI_TEXT_PROVIDER=mock
AI_IMAGE_PROVIDER=mock
AI_TEXT_MODEL_STRONG=
AI_TEXT_MODEL_CHEAP=
# Thinking depth per route: low | medium | high | xhigh | max. Leave blank to
# send nothing (some models, e.g. claude-haiku-4-5, reject the parameter).
# Suggested with claude-opus-5-5: medium for drafting, low for hook sets.
AI_TEXT_EFFORT_STRONG=
AI_TEXT_EFFORT_CHEAP=
# Server-side refusal fallbacks (Claude API): "default" re-runs a declined
# request on Anthropic's recommended model for that refusal category, inside
# the same call. "off" returns the refusal as an error instead.
AI_TEXT_FALLBACKS=default
# Per request, in milliseconds. Generation runs in the request thread (no job
# queue yet), so this bounds how long one click can wait.
AI_TEXT_TIMEOUT_MS=120000
# Short-window limits on model calls, per minute: one person, and a whole
# workspace. 0 turns one off. Separate from the monthly cap in Settings.
# Sign-in emails are limited too (5 per account per 15 minutes, not a setting).
AI_RATE_PER_USER_MINUTE=20
AI_RATE_PER_WORKSPACE_MINUTE=60
# Voice notes (onboarding G5, the party questions). Claude reads text, not
# audio, so speech to text is its own provider. "off" offers typing instead.
# To record voice notes: AI_TRANSCRIBE_PROVIDER=openai, OPENAI_API_KEY and a
# transcription model name (e.g. the provider's current speech-to-text model).
# The audio is sent once to be transcribed and is never stored here.
AI_TRANSCRIBE_PROVIDER=off
AI_TRANSCRIBE_MODEL=
# Visuals are rendered from templates (brief §09), so only mock is built.
AI_IMAGE_MODEL=
# Provider keys (only for non-mock providers):
# ANTHROPIC_API_KEY=
# CONTRACTUAL: client data must never be used for provider training/eval (§07).
# Anthropic does not train on API inputs or outputs under its commercial terms.
# Zero data retention is a separate agreement and is NOT assumed here.
AI_PROVIDER_NO_TRAINING=true

# Agent answers render with OpenUI (@openuidev/*, MIT). Its install script
# sends anonymous install telemetry unless this is set: keep it set here AND
# in the host's build environment (Vercel: Project Settings > Environment
# Variables). Runtime telemetry is opt-in and stays off. See docs/agent-answers.md.
OPENUI_TELEMETRY_DISABLED=1

# --- Jobs ----------------------------------------------------------------------
# There is no job queue yet: every generation runs in the request (see
# docs/phase-two.md). On Vercel, raise the function time limit for long ones
# (Project Settings > Functions > Max Duration, e.g. 300 s on Pro).

# ---- Connections: Gmail, Google Docs, Google Calendar, LinkedIn -------------
# Off until set. Full setup, scopes and Google/LinkedIn review rules:
# docs/integrations.md. Redirect URIs to register (APP_URL + path):
#   /connections/callback/google     /connections/callback/linkedin
# Tokens are encrypted with CONNECTIONS_KEY before they reach the database.
# Generate it once:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTIONS_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Docs picker: a browser API key restricted to APP_URL, and the Cloud project number.
GOOGLE_PICKER_API_KEY=
GOOGLE_PROJECT_NUMBER=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Only once LinkedIn has approved the app for r_member_social (partner programme).
LINKEDIN_POSTS_APPROVED=false

# Hide the "Mock AI" badge in the editor header (client demos). The copy is still sample copy.
# HIDE_MOCK_BADGE=1

# Background jobs: drafts from every pillar and the 90-day plan run in a queue.
# They start right after the request that queues them and keep going while the
# page watches them. A scheduler calling GET /api/cron every few minutes with
# "Authorization: Bearer <CRON_SECRET>" runs retries nobody is watching
# (Vercel Cron sends exactly that header; any uptime pinger works too).
# 16+ random characters, e.g. `openssl rand -hex 24`.
CRON_SECRET=

# ---- Error tracking (optional) ------------------------------------------------
# Without a DSN, server errors are only written to the log (JSON lines; warn
# and error on stderr). With one, each is also sent to Sentry over its plain
# HTTP endpoint (no SDK). The Sentry account and project MUST be in the
# client's own name, not a developer's: Sentry > Project Settings > Client
# Keys (DSN). Never commit a real DSN; set it in the host's environment.
SENTRY_DSN=
# Tags events, e.g. production or preview. Defaults to NODE_ENV.
SENTRY_ENVIRONMENT=
