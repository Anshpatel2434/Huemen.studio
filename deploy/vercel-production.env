# Huemen.studio on Vercel, production (client-ready).
# Paste this whole file into Vercel > Project Settings > Environment Variables
# (the "paste .env" box), Production scope. Fill the blank ones in Vercel's
# page only, never in this file, never in chat. Do not commit filled values.

# ---- Fill in Vercel (secrets) ----------------------------------------------
DATABASE_URL=
DATABASE_ADMIN_URL=
DATABASE_APP_PASSWORD=
AUTH_SECRET=
CRON_SECRET=
CONNECTIONS_KEY=
GROQ_API_KEY=
RUNPOD_API_KEY=
RESEND_API_KEY=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# ---- Fill in Vercel (not secret, but yours) --------------------------------
# The live address, e.g. https://studio.thebrandprofessor.com
APP_URL=
# A sender on a domain verified in Resend, e.g. Huemen.studio <studio@yourdomain.com>
MAIL_FROM=

# ---- Ready as is -------------------------------------------------------------
NODE_ENV=production
DATABASE_POOL_MAX=2
AUTH_DRIVER=email
MAIL_PROVIDER=resend
STORAGE_DRIVER=s3
STORAGE_S3_BUCKET=huemen
STORAGE_S3_REGION=ap-south-1
STORAGE_SIGNED_URL_TTL_SECONDS=300
QUEUE_DRIVER=pg

AI_TEXT_PROVIDER=groq
AI_TEXT_MODEL_STRONG=openai/gpt-oss-120b
AI_TEXT_MODEL_CHEAP=openai/gpt-oss-20b
AI_TEXT_EFFORT_STRONG=medium
AI_TEXT_EFFORT_CHEAP=low
AI_TEXT_FALLBACKS=default
AI_TEXT_TIMEOUT_MS=120000
AI_VISION_MODEL=qwen/qwen3.8-27b
AI_TRANSCRIBE_PROVIDER=groq
AI_TRANSCRIBE_MODEL=whisper-large-v3-turbo

AI_IMAGE_PROVIDER=runpod
AI_IMAGE_MODEL=qwen-image-t2i
AI_IMAGE_EDIT_MODEL=qwen-image-edit
AI_IMAGE_EXTEND_MODEL=google-nano-banana-2-edit
AI_IMAGE_ERASE_MODEL=google-nano-banana-2-edit
# Remove background needs a normal Node host; on Vercel it shows disabled with its reason.
AI_CUTOUT_PROVIDER=off

AI_PROVIDER_NO_TRAINING=true
OPENUI_TELEMETRY_DISABLED=1
HIDE_MOCK_BADGE=true
